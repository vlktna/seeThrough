# No environment variables are required by the base Expo Go project.
# Copy this file to .env.local when adding optional integrations.
# EXPO_PUBLIC_* values are embedded in the app and are NOT secret.
# Configure the same public variables in EAS environment "preview" for updates.
# CI supplies EXPO_PUBLIC_COMMIT_SHA automatically for the app's version display.

# Optional future Supabase integration (not connected by this setup):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-client-publishable-key

# Never put EXPO_TOKEN, Supabase service-role keys, or AI provider keys here.
# EXPO_TOKEN belongs in GitHub Actions repository secrets only.
